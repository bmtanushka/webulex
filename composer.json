{
  "name": "webulex/website",
  "description": "Webulex marketing website (plain PHP, no framework)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "phpmailer/phpmailer": "^6.9",
    "erusev/parsedown": "^1.7"
  },
  "config": {
    "vendor-dir": "public_html/vendor",
    "platform": {
      "php": "8.2.0"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php tools/clean-vendor.php"
    ],
    "post-update-cmd": [
      "@php tools/clean-vendor.php"
    ]
  }
}
